# Copy to .env
PORT=4350
BOT_NAME=Notetaker
# AI for notes. Pick the provider in Settings → AI (keys pasted there are stored encrypted).
# Server-wide fallback keys:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Only if your key isn't tied to a workspace (console.anthropic.com > Settings > Workspaces, id starts with wrkspc_)
ANTHROPIC_WORKSPACE_ID=
# Optional: transcribe the recording when the meeting has no captions (e.g. Zoom host disabled CC)
DEEPGRAM_API_KEY=
# Bot timing (minutes)
ADMIT_TIMEOUT_MIN=10
ALONE_TIMEOUT_MIN=1
MAX_MEETING_MIN=180
# 1 = headless (records few video frames; keep 0 locally, use Xvfb on servers)
BOT_HEADLESS=0
# Set to 1 behind HTTPS (Dokploy) so the login cookie is Secure
COOKIE_SECURE=0
# 0 = hide "Continue with Google" on the login page (calendar connect works either way)
GOOGLE_LOGIN=1
# 1 = anyone can sign up. Default: the first account, then invited emails only
OPEN_SIGNUP=0

# --- Branding (white-label) ---
# Preset: a file in brands/ (e.g. brands/example.json -> BRAND=example). Any field below overrides it.
BRAND=
BRAND_NAME=
BRAND_TAGLINE=
BRAND_LOGO_URL=
BRAND_COLOR=
BRAND_COLOR_2=
BRAND_ACCENT=
BRAND_THEME=
# Encryption key for API keys saved in Settings (default: generated into DATA_DIR/secret.key)
TOKEN_KEY=
# Only these email domains can sign in (Google or email), e.g. example.com
ALLOWED_EMAIL_DOMAINS=
SUMOPOD_API_KEY=

# Magic-link sign-in (email). Either SMTP_URL, or SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASS. Plus the From address.
SMTP_URL=
MAIL_FROM=
